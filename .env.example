# Public configuration example. Copy to .env and fill in your own values.
# .env is private and is not loaded automatically by the Python script.
API_REGION=cn
RECEIVER_PORT=3939
PUBLIC_HOST=receiver.example.invalid
OUTPUT_ROOT=/data
MYSEKAI_RESOURCE_MAP_JSON=/data/config/mysekai_resource_map.json
RETENTION_COUNT=25
TZ=Asia/Shanghai

# Optional map-query authentication; choose your own secret.
PLUGIN_API_KEY=
PLUGIN_QUERY_IMAGE_RETENTION=25

# Rendering.
MYSEKAI_MAP_IMAGE_SIZE=1024
MYSEKAI_ICON_SIZE=36
MYSEKAI_COUNT_FONT_SIZE=18
MYSEKAI_ICON_SPREAD=22
MYSEKAI_ICON_ENHANCE=1
MYSEKAI_ICON_SHARP_RADIUS=0.8
MYSEKAI_ICON_SHARP_PERCENT=130
MYSEKAI_ICON_SHARP_THRESHOLD=2

# Optional diamond notification to an existing OneBot HTTP service.
BOT_PUSH_ENABLED=0
BOT_PUSH_URL=http://onebot:3000
BOT_TOKEN=
BOT_PUSH_MODE=group
BOT_TARGET_ID=
NOTIFICATION_USER_LABEL=player
BOT_PUSH_RETRY=3
BOT_MESSAGE_MODE=text+image
NOTIFICATION_WINDOW_CACHE_HOURS=72
NOTIFICATION_HIT_RETENTION=100
NOTIFICATION_EVENT_RETENTION_LINES=5000
