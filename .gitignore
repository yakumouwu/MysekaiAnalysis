!/04_artifacts/docker_receiver_3939_dev/README_DOCKER.md
!/04_artifacts/docker_receiver_3939_dev/README_DOCKER.zh-CN.md
!/04_artifacts/docker_receiver_3939_dev/dockerScripts/
/04_artifacts/docker_receiver_3939_dev/dockerScripts/*
!/04_artifacts/docker_receiver_3939_dev/dockerScripts/import http.py
