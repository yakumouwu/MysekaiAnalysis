!/04_artifacts/docker_receiver_3939_dev/dockerScripts/mysekai_assets/
/04_artifacts/docker_receiver_3939_dev/dockerScripts/mysekai_assets/*
!/04_artifacts/docker_receiver_3939_dev/dockerScripts/mysekai_assets/icon/
