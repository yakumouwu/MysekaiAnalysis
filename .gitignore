!/tests/
/tests/*
!/tests/test_receiver_unit.py
!/tests/test_receiver_migration.py

# Credentials and runtime output are never publication candidates.
**/node_modules/
**/__pycache__/
**/*.pyc
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.sqlite*
**/*.db*
**/*.log
AGENTS.md
AGENTS.override.md
