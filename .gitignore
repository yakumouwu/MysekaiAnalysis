# Publish only the Mysekai diamond-analysis source and public examples.
*
!/.gitignore
!/README.md
!/README.zh-CN.md
!/requirements.txt
!/.env.example

!/01_scripts/
/01_scripts/*
!/01_scripts/mysekai_resource_map.json

!/04_artifacts/
/04_artifacts/*
!/04_artifacts/docker_receiver_3939_dev/
/04_artifacts/docker_receiver_3939_dev/*
!/04_artifacts/docker_receiver_3939_dev/Dockerfile
